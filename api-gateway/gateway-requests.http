### 1. Auth hello through gateway
GET http://localhost:8080/auth/hello

### 2. Login through gateway
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "123456"
}

### 3. Create project with token
POST http://localhost:8080/projects
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0ZXN0dXNlciIsImlhdCI6MTc3NjUyNjE0MywiZXhwIjoxNzc2NjEyNTQzfQ.fedKEl4Sr6c5KUMgNxxKCcvy48HkU6dewHaXzpBAFA0
Content-Type: application/json

{
  "name": "JWT Project",
  "description": "Created from token user"
}

### 4. Get projects with token
GET http://localhost:8080/projects
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0ZXN0dXNlciIsImlhdCI6MTc3NjUyNjE0MywiZXhwIjoxNzc2NjEyNTQzfQ.fedKEl4Sr6c5KUMgNxxKCcvy48HkU6dewHaXzpBAFA0

### 5. Create task with token
POST http://localhost:8080/tasks
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0ZXN0dXNlciIsImlhdCI6MTc3NjUyNjE0MywiZXhwIjoxNzc2NjEyNTQzfQ.fedKEl4Sr6c5KUMgNxxKCcvy48HkU6dewHaXzpBAFA0
Content-Type: application/json

{
  "title": "JWT Task",
  "description": "Task from token user",
  "status": "TODO",
